/**
 * @description This ruleset enforces access control for the application.
 * It segregates data by contract and function. Public read access is granted
 * to most collections, but write access is restricted.
 * @dataStructure
 * - `/contrato_c4_2025_definitions/{definitionId}`: Equipment definitions for C-4/2025.
 * - `/contrato_c4_2025_inventory/{equipmentId}`: Equipment inventory for C-4/2025.
 * - `/contrato_c4_2025_workOrders/{workOrderId}`: Work orders for C-4/2025.
 * - `/contrato_c4_2025_maintenancePlans/{planId}`: Maintenance plans for C-4/2025.
 * - `/contrato_c4_2025_checklists/{checklistId}`: Checklists for C-4/2025.
 * - `/vehicles/{vehicleId}`: Vehicle data.
 * - `/operators/{operatorId}`: Operator data.
 * @keySecurityDecisions
 * - Public read access is granted to most collections for ease of development.
 * - Write access is restricted and should be refined with role-based access control.
 * - Future iterations should consider denormalizing role information onto documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to equipment definitions for C-4/2025.
     */
    match /contrato_c4_2025_definitions/{definitionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read-only access to equipment inventory for C-4/2025.
     */
    match /contrato_c4_2025_inventory/{equipmentId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read-only access to work orders for C-4/2025.
     */
    match /contrato_c4_2025_workOrders/{workOrderId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    
    /**
     * @description Allows read-only access to maintenance plans for C-4/2025.
     */
    match /contrato_c4_2025_maintenancePlans/{planId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    /**
     * @description Allows read-only access to checklists for C-4/2025.
     */
    match /contrato_c4_2025_checklists/{checklistId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }
    
    /**
     * @description Allows read-only access to vehicle data.
     */
    match /vehicles/{vehicleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read-only access to operator data.
     */
    match /operators/{operatorId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}

    